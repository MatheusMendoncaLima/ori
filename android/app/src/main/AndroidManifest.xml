<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ hides other apps by default; this lets the app find the installed voice engine. -->
    <!-- ORI Home: "Desinstalar" in the menu of an app opens Android's own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- ORI Home: the wallpaper of the lock screen, only when the person chooses "Tela de bloqueio". -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- ORI Home: a swipe down on the home screen opens Android's notification panel (a normal permission). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- ORI Home: the apps with an icon in the drawer, without QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- ORI Home: the clock app of the device, whose widgets come first in the list of widgets. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- ORI Home: the widgets the installed apps offer. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- ORI Home: the home app in use, to go back to it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".OriApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ori"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ori"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            ORI Home, the optional home screen (docs/funcionalidades/launcher.md). Off until the person turns it on
            in the settings (HomeActivation.setLauncherEnabled), so ORI never shows up as a home app unasked.
        -->
        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/launcher_title"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ori.Launcher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Android's "Adicionar à tela inicial": an app asks the home app in use to put a shortcut or a widget on it.
            Off and on with ORI Home's own entry (HomeActivation.setLauncherEnabled). Exported because Android opens
            it; a request is trusted only when Android carries it out (PinRequestActivity).
        -->
        <activity
            android:name=".ui.launcher.PinRequestActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ori.Translucent">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <!--
            Android's windows for a widget (the "allow" window, the setup of the widget's app), opened from this plain
            screen: from the home screen they would go to a task of their own and their answer would be lost.
        -->
        <activity
            android:name=".ui.launcher.WidgetStepActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Ori.Translucent" />

        <!--
            The badges on the icons of ORI Home: counts how many notifications each app shows, only while the person
            allows it in Android's "Acesso a notificações". Of each notification it reads only the app and its number;
            what it says is never read, kept or sent. Off and on with ORI Home's own entry.
        -->
        <service
            android:name=".data.launcher.BadgeNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/launcher_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>