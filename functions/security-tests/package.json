{
  "name": "ori-security-tests",
  "private": true,
  "type": "module",
  "description": "Firestore rules and Cloud Functions authorization tests, run against the local emulator.",
  "scripts": {
    "pretest": "npm --prefix ../functions run build",
    "test": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-ori \"node --test --test-concurrency=1 test/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "prettier": "3.6.2"
  }
}
