# Shared formatting rules for every language in the repository.
# Kotlin formatting is verified by detekt (ktlint rules); TypeScript by ESLint/Prettier.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
